"""Synthetic semantic tests, independent closure oracle, and known-bad controls."""
from typing import Callable
from builtins import list, dict, len, range, ValueError, AssertionError
import json
import circuit
import demo
import crv2002


def check(condition ∈ bool, name ∈ str) → None:
    if condition == False:
        raise AssertionError(name)


def fuse_regression(survivors ∈ list[str]) → None:
    check("open:driver_fuse" in survivors, "Working sibling must not clear driver fuse")
    shared_open_retained ∈ bool ← "open:common_fuse" in survivors
    check(shared_open_retained == False, "Working sibling contradicts a completely open common feed in this model")
    check("motor_unavailable:driver" in survivors and "mechanism_blocked:driver" in survivors, "No motion is not proof of an electrical open")
    check(len(survivors) == 7, "Expected seven initial candidates, not a diagnosis")


def oracle_reach(edges ∈ list[tuple[str, str, str]], start ∈ str, target ∈ str) → bool:
    # Independently implemented Boolean transitive closure, not the production BFS.
    nodes ∈ list[str] ← ["a", "b", "c", "d"]
    relation ∈ dict[str, dict[str, bool]] ← {}
    for x in nodes:
        row ∈ dict[str, bool] ← {}
        for y in nodes:
            row[y] ← x == y
        relation[x] ← row
    for edge in edges:
        relation[edge[1]][edge[2]] ← True
        relation[edge[2]][edge[1]] ← True
    for middle in nodes:
        for x in nodes:
            for y in nodes:
                relation[x][y] ← relation[x][y] or (relation[x][middle] and relation[middle][y])
    return relation[start][target]


def graph_checks(tracer ∈ Callable[[list[tuple[str, str, str]], str, str], dict[str, list[str]]]) → int:
    edges ∈ list[tuple[str, str, str]] ← [("ab", "a", "b"), ("ab_parallel", "a", "b"), ("bc", "b", "c"), ("cd", "c", "d"), ("loop", "b", "b")]
    count ∈ int ← 0
    for mask in range(32):
        active ∈ list[tuple[str, str, str]] ← []
        for index in range(5):
            if (mask & (1 << index)) != 0:
                active.append(edges[index])
        for start in ["a", "b", "c", "d"]:
            reached ∈ dict[str, list[str]] ← tracer(active, start, "")
            for target in ["a", "b", "c", "d"]:
                check((target in reached) == oracle_reach(active, start, target), "BFS disagrees with independent closure")
                count ← count + 1
    return count


def bad_trace(edges ∈ list[tuple[str, str, str]], start ∈ str, open_edge ∈ str) → dict[str, list[str]]:
    result ∈ dict[str, list[str]] ← {"a": [], "b": [], "c": [], "d": []}
    return result


def main() → dict[str, object]:
    result ∈ tuple[list[str], dict[str, list[str]]] ← demo.assess(demo.observations)
    fuse_regression(result[0])
    expected ∈ list[str] ← ["mechanism_blocked:driver", "motor_unavailable:driver", "open:driver_forward_positive", "open:driver_forward_return", "open:driver_fuse", "open:driver_wire_a", "open:driver_wire_b"]
    check(result[0] == expected, "Exact initial candidate set")
    states ∈ dict[str, list[tuple[str, str, str]]] ← demo.states
    unknown_states ∈ list[str] ← demo.unknown_states
    supply ∈ tuple[str, str] ← demo.supply
    loads ∈ dict[str, tuple[str, str]] ← demo.loads
    nominal ∈ tuple[str, str] ← ("", "")
    forward ∈ str ← circuit.predict(states, unknown_states, supply, loads, nominal, "forward", "drive", "driver")
    reverse ∈ str ← circuit.predict(states, unknown_states, supply, loads, nominal, "reverse", "drive", "driver")
    check(forward == "forward" and reverse == "reverse", "Reversing polarity")
    floating ∈ str ← circuit.predict(states, unknown_states, supply, loads, nominal, "forward", "rail", "sensor_unmapped")
    check(floating == "floating", "Floating is not ground")
    unknown ∈ str ← circuit.predict(states, unknown_states, supply, loads, nominal, "unspecified", "drive", "driver")
    check(unknown == "unknown", "Unspecified state must not become open")
    off ∈ str ← circuit.predict(states, unknown_states, supply, loads, nominal, "ignition_off", "rail", "common_bus")
    check(off == "positive", "Ignition off does not disconnect every node")
    witness ∈ dict[str, list[str]] ← circuit.paths(states["forward"], supply[0], "")
    check(witness["driver_a_motor"] == ["common_fuse", "enable_contact", "driver_fuse", "driver_forward_positive", "driver_wire_a"], "Exact branch path")
    requirements ∈ list[str] ← ["trim_removed", "door_cavity_open", "trim_removed"]
    done ∈ list[str] ← demo.already_accessible
    costs ∈ dict[str, int] ← demo.access_costs
    cost ∈ int ← circuit.marginal_cost(requirements, done, costs, 1)
    check(cost == 6, "Removed trim and duplicate prerequisites are not charged twice")
    all_open ∈ list[str] ← ["trim_removed", "door_cavity_open"]
    open_cost ∈ int ← circuit.marginal_cost(requirements, all_open, costs, 1)
    check(open_cost == 1, "Marginal access cost changes with actual access state")
    access ∈ dict[str, list[str]] ← demo.repair_access
    initial_access ∈ list[str] ← circuit.common_repair_access(result[0], access, done)
    check(len(initial_access) == 0, "Not every initial candidate needs door access")
    observations ∈ list[tuple[str, str, str, str]] ← list(demo.observations)
    observations.append(("forward", "rail", "driver_a_switch", "positive"))
    observations.append(("forward", "rail", "driver_b_switch", "negative"))
    door_result ∈ tuple[list[str], dict[str, list[str]]] ← demo.assess(observations)
    check(door_result[0] == ["mechanism_blocked:driver", "motor_unavailable:driver", "open:driver_wire_a", "open:driver_wire_b"], "Motor, mechanism and door wires remain")
    common ∈ list[str] ← circuit.common_repair_access(door_result[0], access, done)
    check(common == ["door_cavity_open"], "All remaining modeled repairs share access")
    contradictions ∈ list[tuple[str, str, str, str]] ← list(demo.observations)
    contradictions.append(("forward", "motion", "driver", "forward"))
    contradictory ∈ tuple[list[str], dict[str, list[str]]] ← demo.assess(contradictions)
    check(len(contradictory[0]) == 0, "Contradictions must not force a fault")
    incomplete ∈ list[tuple[str, str, str, str]] ← [("unspecified", "motion", "driver", "stopped")]
    incomplete_result ∈ tuple[list[str], dict[str, list[str]]] ← demo.assess(incomplete)
    faults ∈ dict[str, tuple[str, str]] ← demo.faults
    check(len(incomplete_result[0]) == len(faults), "Unknown predictions eliminate nothing")
    test ∈ tuple[str, str, str] ← ("forward", "drive", "driver")
    partition ∈ dict[str, list[str]] ← circuit.partition_test(states, unknown_states, supply, loads, faults, result[0], test)
    pairs ∈ int ← circuit.separated_pairs(partition)
    check(pairs == 10, "Drive separates five opens from two blocked-load candidates")
    choices ∈ list[tuple[str, int, int]] ← [("cheap", 1, 3), ("dominated", 2, 3), ("deep", 5, 10), ("uninformative", 0, 0)]
    preferred ∈ list[str] ← circuit.pareto_tests(choices)
    check(preferred == ["cheap", "deep"], "Pareto comparison preserves effort/information tradeoff")
    invalid_nodes ∈ list[str] ← ["a", "b"]
    invalid_edges ∈ list[tuple[str, str, str]] ← [("wire", "a", "missing")]
    endpoint_errors ∈ list[str] ← circuit.graph_errors(invalid_nodes, invalid_edges)
    check(len(endpoint_errors) > 0, "Reject invented terminal")
    duplicate_edges ∈ list[tuple[str, str, str]] ← [("wire", "a", "b"), ("wire", "a", "b")]
    duplicate_errors ∈ list[str] ← circuit.graph_errors(invalid_nodes, duplicate_edges)
    check(len(duplicate_errors) > 0, "Reject duplicate conductor identities")
    shorted ∈ list[tuple[str, str, str]] ← [("short", "positive", "negative")]
    short_rejected ∈ bool ← False
    try:
        circuit.rail_paths(shorted, supply, "")
    except ValueError:
        short_rejected ← True
    check(short_rejected, "Reject contradictory ideal source rails")
    instrument_rejected ∈ bool ← False
    try:
        circuit.predict(states, unknown_states, supply, loads, nominal, "forward", "test_light", "driver")
    except ValueError:
        instrument_rejected ← True
    check(instrument_rejected, "No silent instrument conversion")
    mutant ∈ list[str] ← list(result[0])
    mutant.remove("open:driver_fuse")
    bad_fuse_rejected ∈ bool ← False
    try:
        fuse_regression(mutant)
    except AssertionError:
        bad_fuse_rejected ← True
    check(bad_fuse_rejected, "Regression rejects original sibling-fuse error")
    graph_count ∈ int ← graph_checks(circuit.paths)
    bad_graph_rejected ∈ bool ← False
    try:
        graph_checks(bad_trace)
    except AssertionError:
        bad_graph_rejected ← True
    check(bad_graph_rejected, "Oracle rejects all-connected graph mutant")
    repeated ∈ tuple[list[str], dict[str, list[str]]] ← demo.assess(demo.observations)
    check(repeated == result, "Deterministic replay")
    # Honda source-backed protection case. The observations projected into the
    # ideal checker represent qualitative operability, NOT measured motor rails.
    no_physical_results ∈ list[tuple[str, str, str, str]] ← []
    crv_initial ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(no_physical_results)
    crv_expected ∈ list[str] ← [
        "mechanism_blocked:driver", "motor_unavailable:driver",
        "open:driver_command_proxy", "open:driver_harness_proxy",
        "open:under_dash_23_20A"
    ]
    check(crv_initial[0] == crv_expected, "2002 CR-V projection retains dedicated #23 and unresolved alternatives")
    crv_survivors ∈ list[str] ← crv_initial[0]
    common_survives ∈ bool ← "open:common_feed_proxy" in crv_survivors
    driver_fuse_survives ∈ bool ← "open:under_dash_23_20A" in crv_survivors
    check(common_survives == False, "Operating sibling disfavours complete common-feed open in this ideal model")
    check(driver_fuse_survives, "A working sibling never clears #23")
    check(crv2002.protection["front_left_driver"] == "under_dash_23_20A", "Verified chart assigns #23 to driver's front-left window")
    check(crv2002.protection["front_right"] == "under_dash_22_20A", "Separate front-right #22 fuse")
    check(crv2002.protection["rear_left"] == "under_dash_24_20A" and crv2002.protection["rear_right"] == "under_dash_25_20A", "Separate rear-window fuses")
    check(crv2002.reported["ignition"] == "ON" and crv2002.reported["instrument"] == "test_light", "Do not re-ask or change tester")
    check(crv2002.not_run["under_dash_23_both_test_points"] == "NOT_RUN", "A modeled test is not a measurement")
    check(crv2002.not_run["exact_connector_cavities_and_orientation"] == "UNKNOWN", "No invented connector cavities")
    check(crv2002.projected_operation[0][1] == "motion", "No reported connector voltage was turned into an ideal rail")
    no_access ∈ list[str] ← []
    check(circuit.common_repair_access(crv_survivors, crv2002.repair_access, no_access) == no_access, "Door access not inevitable with #23 unresolved")
    crv_scores ∈ list[tuple[str, int, int]] ← crv2002.compare_ideal_tests(crv_survivors, no_access)
    check(crv_scores == [
        ("fuse23_ideal_output", 2, 4),
        ("controller_ideal_output", 4, 6),
        ("motor_ideal_feed", 9, 6)
    ], "Cheap #23 output test distinguishes fuse without door; costly motor proxy is dominated")
    check(circuit.pareto_tests(crv_scores) == ["controller_ideal_output", "fuse23_ideal_output"], "Access-aware ideal comparison")
    # The latter ideal test is NOT executable on the Honda until a connector
    # identity, correct view and test instructions have been admitted.
    fuse_positive ∈ list[tuple[str, str, str, str]] ← [
        ("representative_command", "rail", "fuse23_out", "positive")
    ]
    fuse_floating ∈ list[tuple[str, str, str, str]] ← [
        ("representative_command", "rail", "fuse23_out", "floating")
    ]
    crv_pos ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(fuse_positive)
    crv_open ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(fuse_floating)
    check(crv_pos[0] == [
        "mechanism_blocked:driver", "motor_unavailable:driver",
        "open:driver_command_proxy", "open:driver_harness_proxy"
    ], "Hypothetical energized fuse output does not diagnose the motor")
    check(crv_open[0] == ["open:under_dash_23_20A"], "Hypothetical floating ideal output partitions single-open model")
    check(circuit.common_repair_access(crv_pos[0], crv2002.repair_access, no_access) == ["door_trim"], "Fused-good model still includes a controller-access branch")
    controller_positive ∈ list[tuple[str, str, str, str]] ← [
        ("representative_command", "rail", "driver_command_proxy_out", "positive")
    ]
    post_controller ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(controller_positive)
    check(post_controller[0] == [
        "mechanism_blocked:driver", "motor_unavailable:driver", "open:driver_harness_proxy"
    ], "Only hypothetical source-verified controller feed eliminates upstream candidates")
    trim_removed ∈ list[str] ← ["door_trim"]
    check(circuit.common_repair_access(post_controller[0], crv2002.repair_access, trim_removed) == ["door_cavity"], "Conditional cavity need after additional ideal evidence and removed trim")
    contradictions_crv ∈ list[tuple[str, str, str, str]] ← list(fuse_positive)
    contradictions_crv.append(fuse_floating[0])
    impossible ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(contradictions_crv)
    check(len(impossible[0]) == 0, "Contradictory hypothetical fuse results do not force a component")
    no_discriminator ∈ list[tuple[str, str, str, str]] ← [
        ("representative_command", "rail", "fuse23_out", "unknown")
    ]
    still_unknown ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(no_discriminator)
    check(still_unknown[0] == crv_initial[0], "An unperformed fuse test cannot narrow faults")
    one_lit ∈ str ← crv2002.fuse_lamp_interpretation("one_lit_one_dark")
    both_lit ∈ str ← crv2002.fuse_lamp_interpretation("both_lit")
    neither_lit ∈ str ← crv2002.fuse_lamp_interpretation("neither_lit")
    check("suspect_open_fuse" in one_lit, "One live / one dark needs further physical checking")
    check("not_proof_of_motor_current" in both_lit, "Two lit pads do not prove motor supply")
    check("not_proof_of_open_fuse" in neither_lit, "Two unlit pads are not a blown-fuse diagnosis")
    invalid_lamp ∈ bool ← False
    try:
        crv2002.fuse_lamp_interpretation("unknown_lamp_pattern")
    except ValueError:
        invalid_lamp ← True
    check(invalid_lamp, "Physical lamp input must be explicitly recognized")
    # Known-bad controls for two failures in the actual prior advice.
    wrongly_cleared ∈ list[str] ← list(crv_initial[0])
    wrongly_cleared.remove("open:under_dash_23_20A")
    bad_retains_fuse ∈ bool ← "open:under_dash_23_20A" in wrongly_cleared
    bad_sibling_inference_rejected ∈ bool ← bad_retains_fuse == False and driver_fuse_survives
    check(bad_sibling_inference_rejected, "Mutation: erroneously cleared independent fuse")
    falsely_forced_cavity ∈ list[str] ← ["door_cavity"]
    actual_initial_access ∈ list[str] ← circuit.common_repair_access(crv_survivors, crv2002.repair_access, no_access)
    check(falsely_forced_cavity != actual_initial_access, "Mutation: no unconditional door dismantling")
    repeat_crv ∈ tuple[list[str], dict[str, list[str]]] ← crv2002.assess(no_physical_results)
    check(repeat_crv == crv_initial, "Source-backed CR-V projection replays deterministically")
    return {"status": "passed", "exhaustive_reachability_comparisons": graph_count, "known_bad_controls_rejected": 2, "vehicle_acceptance": "NOT_RUN", "demo_survivors": result[0], "crv_abstract_candidates": crv_initial[0], "crv_physical_fuse_test": "NOT_RUN"}


if __name__ == "__main__":
    print(json.dumps(main(), sort_keys=True, indent=2))
