"""Bounded, synthetic-only circuit diagnosis. No hardware control or service pinout."""
from typing import Any
from builtins import dict, list, set, len, sorted, type, str, int, bool, max, any, ValueError, KeyError, TypeError
from pathlib import Path
import hashlib
import json
import sys


def require(condition ∈ bool, message ∈ str) → None:
    if condition == False:
        raise ValueError(message)


def fields(row ∈ Any, names ∈ str) → None:
    require(type(row) == dict, "Expected a record")
    require(set(row.keys()) == set(names.split()), "Unexpected or missing fields: " + names)


def names(values ∈ Any, allowed ∈ list) → None:
    require(type(values) == list, "Expected a list of identifiers")
    require(len(values) == len(set(values)), "Duplicate identifier")
    for value in values:
        require(type(value) == str and value in allowed, "Unknown identifier: " + str(value))


def row_ids(rows ∈ Any) → list[str]:
    require(type(rows) == list, "Expected records")
    result ∈ list[str] ← []
    for row in rows:
        require(type(row) == dict and type(row.get("id")) == str, "Record needs a string identifier")
        identifier ∈ str ← row["id"]
        require(identifier != "" and identifier not in result, "Empty or duplicate identifier")
        result.append(identifier)
    return result


def find(rows ∈ list, identifier ∈ str) → dict:
    for row in rows:
        if row["id"] == identifier:
            return row
    raise ValueError("Unknown record: " + identifier)


def validate_measurement(model ∈ dict, row ∈ dict) → None:
    require(row["state"] in model["states"], "Unknown operating state")
    quantity ∈ str ← row["quantity"]
    require(quantity in ["rail", "drive", "motion"], "Unsupported quantity; test-light and numerical voltage readings must not be converted to ideal rails")
    targets ∈ list ← model["nodes"]
    if quantity != "rail":
        targets ← row_ids(model["loads"])
    require(row["target"] in targets, "Unknown measurement target")


def validate(model ∈ Any) → None:
    fields(model, "scope id nodes positive negative edges states loads observations tests access_costs already_accessible")
    require(model["scope"] == "synthetic", "Only synthetic models are admitted in this prototype; OEM source admission is not implemented")
    require(type(model["id"]) == str and model["id"] != "", "Model identifier required")
    nodes ∈ Any ← model["nodes"]
    require(type(nodes) == list and 2 <= len(nodes) <= 64, "Require 2..64 terminals")
    names(nodes, nodes)
    require(model["positive"] in nodes and model["negative"] in nodes and model["positive"] != model["negative"], "Distinct named source terminals required")
    access ∈ Any ← model["access_costs"]
    require(type(access) == dict, "Access costs must be a record")
    for key in access:
        require(type(key) == str and type(access[key]) == int and access[key] >= 0, "Access costs are nonnegative integer effort units, not probabilities")
    names(model["already_accessible"], list(access))
    edge_ids ∈ list[str] ← row_ids(model["edges"])
    load_ids ∈ list[str] ← row_ids(model["loads"])
    require(len(edge_ids) <= 128 and 1 <= len(load_ids) <= 16, "Model bounds exceeded")
    for edge in model["edges"]:
        fields(edge, "id a b kind evidence repair_access")
        require(edge["a"] in nodes and edge["b"] in nodes, "Unknown edge endpoint")
        require(edge["kind"] in ["wire", "fuse", "contact"], "Only ideal conductors, fuses and contacts are implemented")
        require(type(edge["evidence"]) == str and edge["evidence"] != "", "Connection evidence required")
        names(edge["repair_access"], list(access))
    require(type(model["states"]) == dict and 1 <= len(model["states"]) <= 16, "Require 1..16 named states")
    for state in model["states"]:
        require(type(state) == str and state != "", "Named state required")
        active ∈ Any ← model["states"][state]
        if active is not None:
            names(active, edge_ids)
    for load in model["loads"]:
        fields(load, "id a b evidence repair_access")
        require(load["a"] in nodes and load["b"] in nodes and load["a"] != load["b"], "Distinct load terminals required")
        require(type(load["evidence"]) == str and load["evidence"] != "", "Load evidence required")
        names(load["repair_access"], list(access))
    observation_ids ∈ list[str] ← row_ids(model["observations"])
    test_ids ∈ list[str] ← row_ids(model["tests"])
    require(len(observation_ids) <= 64 and len(test_ids) <= 64, "Observation or test bounds exceeded")
    for observation in model["observations"]:
        fields(observation, "id state quantity target value evidence")
        validate_measurement(model, observation)
        allowed ∈ list[str] ← ["positive", "negative", "floating", "unknown"]
        if observation["quantity"] == "drive":
            allowed ← ["forward", "reverse", "no_complete_drive", "unknown"]
        if observation["quantity"] == "motion":
            allowed ← ["forward", "reverse", "stopped", "unknown"]
        require(observation["value"] in allowed, "Invalid observation value")
        require(type(observation["evidence"]) == str and observation["evidence"] != "", "Observation evidence required")
    for test in model["tests"]:
        fields(test, "id state quantity target access effort")
        validate_measurement(model, test)
        names(test["access"], list(access))
        require(type(test["effort"]) == int and test["effort"] >= 0, "Test effort must be a nonnegative integer")
    # A contradictory nominal schematic is not a diagnosed real-world fault.
    for state in model["states"]:
        solve(model, state, "")


def edge_key(edge ∈ dict) → str:
    return edge["id"]


def paths(edges ∈ list, start ∈ str) → dict:
    """Finite breadth-first reachability; retain edge identities as witnesses."""
    reached ∈ dict ← {start: []}
    queue ∈ list[str] ← [start]
    index ∈ int ← 0
    ordered ∈ list ← sorted(edges, key=edge_key)
    while index < len(queue):
        here ∈ str ← queue[index]
        index ← index + 1
        for edge in ordered:
            other ∈ str ← ""
            if edge["a"] == here:
                other ← edge["b"]
            elif edge["b"] == here:
                other ← edge["a"]
            if other != "" and other not in reached:
                reached[other] ← reached[here] + [edge["id"]]
                queue.append(other)
    return reached


def solve(model ∈ dict, state ∈ str, open_edge ∈ str) → dict:
    active ∈ Any ← model["states"][state]
    if active is None:
        return {"known": False, "positive": {}, "negative": {}}
    edges ∈ list ← []
    for edge in model["edges"]:
        if edge["id"] in active and edge["id"] != open_edge:
            edges.append(edge)
    positive ∈ dict ← paths(edges, model["positive"])
    negative ∈ dict ← paths(edges, model["negative"])
    require(model["negative"] not in positive, "Contradictory ideal source rails in state " + state)
    return {"known": True, "positive": positive, "negative": negative}


def rail(solution ∈ dict, node ∈ str) → str:
    if solution["known"] == False:
        return "unknown"
    if node in solution["positive"]:
        return "positive"
    if node in solution["negative"]:
        return "negative"
    return "floating"


def predict(model ∈ dict, request ∈ dict, hypothesis ∈ dict) → dict:
    solution ∈ dict ← solve(model, request["state"], hypothesis["open_edge"])
    target ∈ str ← request["target"]
    quantity ∈ str ← request["quantity"]
    terminals ∈ list[str] ← [target]
    value ∈ str ← "unknown"
    if quantity == "rail":
        value ← rail(solution, target)
    else:
        load ∈ dict ← find(model["loads"], target)
        terminals ← [load["a"], load["b"]]
        a ∈ str ← rail(solution, load["a"])
        b ∈ str ← rail(solution, load["b"])
        if a != "unknown" and b != "unknown":
            value ← "no_complete_drive"
            if a == "positive" and b == "negative":
                value ← "forward"
            if a == "negative" and b == "positive":
                value ← "reverse"
        if quantity == "motion" and value != "unknown":
            if value == "no_complete_drive" or hypothesis["blocked_load"] == target:
                value ← "stopped"
    witness ∈ dict ← {}
    for node in terminals:
        witness[node] ← {"rail": rail(solution, node), "positive_path": solution["positive"].get(node), "negative_path": solution["negative"].get(node)}
    return {"value": value, "terminal_witnesses": witness, "blocked_load": hypothesis["blocked_load"]}


def hypotheses(model ∈ dict) → list[dict]:
    result ∈ list[dict] ← [{"id": "nominal", "open_edge": "", "blocked_load": "", "repair_access": []}]
    for edge in sorted(model["edges"], key=edge_key):
        result.append({"id": "open:" + edge["id"], "open_edge": edge["id"], "blocked_load": "", "repair_access": edge["repair_access"]})
    for load in sorted(model["loads"], key=edge_key):
        for fault_kind in ["motor_unavailable", "mechanism_blocked"]:
            result.append({"id": fault_kind + ":" + load["id"], "open_edge": "", "blocked_load": load["id"], "repair_access": load["repair_access"]})
    return result


def assess(model ∈ dict) → dict:
    validate(model)
    survivors ∈ list[dict] ← []
    rejected ∈ list[dict] ← []
    for hypothesis in hypotheses(model):
        contradictions ∈ list[dict] ← []
        predictions ∈ list[dict] ← []
        for observation in model["observations"]:
            prediction ∈ dict ← predict(model, observation, hypothesis)
            predictions.append({"observation": observation["id"], "prediction": prediction})
            if observation["value"] != "unknown" and prediction["value"] != "unknown" and observation["value"] != prediction["value"]:
                contradictions.append({"observation": observation["id"], "observed": observation["value"], "prediction": prediction})
        if len(contradictions) == 0:
            survivors.append({"hypothesis": hypothesis, "predictions": predictions})
        else:
            rejected.append({"hypothesis": hypothesis["id"], "contradictions": contradictions})
    shared_access ∈ Any ← set(model["access_costs"])
    if len(survivors) == 0:
        shared_access ← set()
    for survivor in survivors:
        shared_access ← shared_access.intersection(survivor["hypothesis"]["repair_access"])
    state ∈ str ← "underdetermined_in_bounded_model"
    if len(survivors) == 0:
        state ← "no_model_fit"
    elif len(survivors) == 1:
        state ← "single_candidate_in_bounded_model"
    return {"status": state, "scope": "synthetic_model_only", "fault_scope": "nominal, one open conductor/contact/fuse, or one unavailable/bound load; not exhaustive physical diagnosis", "survivors": survivors, "rejected": rejected, "common_remaining_repair_access": sorted(shared_access.difference(model["already_accessible"]))}


def plan_tests(model ∈ dict, assessment ∈ dict) → list[dict]:
    plans ∈ list[dict] ← []
    for test in sorted(model["tests"], key=edge_key):
        partitions ∈ dict ← {}
        for survivor in assessment["survivors"]:
            hypothesis ∈ dict ← survivor["hypothesis"]
            value ∈ str ← predict(model, test, hypothesis)["value"]
            partitions.setdefault(value, []).append(hypothesis["id"])
        count ∈ int ← len(assessment["survivors"])
        separated ∈ int ← count * (count - 1) // 2
        for value in partitions:
            size ∈ int ← len(partitions[value])
            separated ← separated - size * (size - 1) // 2
        if "unknown" in partitions:
            separated ← 0
        missing ∈ list ← sorted(set(test["access"]).difference(model["already_accessible"]))
        cost ∈ int ← test["effort"]
        for step in missing:
            cost ← cost + model["access_costs"][step]
        plans.append({"test": test["id"], "additional_effort": cost, "new_access": missing, "distinguished_candidate_pairs": separated, "partitions": partitions, "pareto_candidate": False})
    # No invented priors, entropy weights, or claim of a globally optimal policy.
    for plan in plans:
        dominated ∈ bool ← False
        for other in plans:
            no_worse ∈ bool ← other["additional_effort"] <= plan["additional_effort"] and other["distinguished_candidate_pairs"] >= plan["distinguished_candidate_pairs"]
            strictly_better ∈ bool ← other["additional_effort"] < plan["additional_effort"] or other["distinguished_candidate_pairs"] > plan["distinguished_candidate_pairs"]
            if no_worse and strictly_better:
                dominated ← True
        plan["pareto_candidate"] ← plan["distinguished_candidate_pairs"] > 0 and dominated == False
    return plans


def report(model ∈ dict) → dict:
    assessment ∈ dict ← assess(model)
    assessment["test_comparisons"] ← plan_tests(model, assessment)
    canonical ∈ str ← json.dumps(model, sort_keys=True, separators=(",", ":"))
    assessment["model_sha256"] ← hashlib.sha256(canonical.encode()).hexdigest()
    assessment["implementation_sha256"] ← hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    assessment["not_implemented"] ← ["schematic image parsing", "OEM pin mapping and source admission", "resistance/current/voltage-drop solving", "test-light or Power Probe instrument models", "multiple faults", "backfeed through loads", "intermittency", "physical repair verification"]
    return assessment


def main() → None:
    require(len(sys.argv) == 2, "Usage: ithon circuit.pi model.json")
    model ∈ Any ← json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    print(json.dumps(report(model), sort_keys=True, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, TypeError) as error:
        print(json.dumps({"status": "blocked", "reason": str(error)}, sort_keys=True))
        sys.exit(2)
